# Teleroute Marketplace - Git Ignore

# Configuration files with sensitive data
config/database.php
config/.installed

# Uploaded files
uploads/*
!uploads/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE Files
.idea/
.vscode/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# Composer
/vendor/
composer.phar
composer.lock

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Temporary files
tmp/
temp/
cache/
*.tmp
*.bak
*.backup

# Environment files
.env
.env.local
.env.*.local

# Installation file (should be deleted after install)
# install.php
