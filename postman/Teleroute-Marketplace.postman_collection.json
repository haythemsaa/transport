		{
			"name": "Freight Offers",
			"item": [
				{
					"name": "Get All Freight Offers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/freight.php?limit=10&offset=0",
							"host": ["{{base_url}}"],
							"path": ["api", "freight.php"],
							"query": [
								{"key": "limit", "value": "10"},
								{"key": "offset", "value": "0"}
							]
						},
						"description": "Récupérer toutes les offres de fret avec pagination"
					}
				},
				{
					"name": "Get Freight by ID",
					"request": {
						"method": "GET",
