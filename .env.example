# =====================================================
# TELEROUTE MARKETPLACE - ENVIRONMENT CONFIGURATION
# =====================================================
#
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# cp .env.example .env
# chmod 600 .env
#

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=teleroute_marketplace
DB_USER=teleroute_user
DB_PASS=your_secure_password_here

# Database charset
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================

# Environment: development, staging, production
APP_ENV=production

# Debug mode (true/false)
# WARNING: Set to false in production!
APP_DEBUG=false

# Application name
APP_NAME="Teleroute Marketplace"

# Application version
APP_VERSION=1.0.0

# Application URL (without trailing slash)
APP_URL=https://teleroute-marketplace.com

# Base path (if not in root directory)
BASE_PATH=/

# Assets URL
ASSETS_URL=/assets

# =====================================================
# SESSION CONFIGURATION
# =====================================================

# Session lifetime in seconds (7200 = 2 hours)
SESSION_LIFETIME=7200

# Session name
SESSION_NAME=TELEROUTE_SESSION

# Session cookie secure (true for HTTPS only)
SESSION_SECURE=false

# Session cookie httponly
SESSION_HTTPONLY=true

# Session cookie samesite (Strict, Lax, None)
SESSION_SAMESITE=Lax

# =====================================================
# SECURITY CONFIGURATION
# =====================================================

# CSRF token name
CSRF_TOKEN_NAME=csrf_token

# CSRF token lifetime in seconds
CSRF_TOKEN_LIFETIME=3600

# Password minimum length
PASSWORD_MIN_LENGTH=8

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION=15

# =====================================================
# MAIL CONFIGURATION
# =====================================================

# SMTP server
MAIL_HOST=smtp.example.com

# SMTP port (25, 465, 587)
MAIL_PORT=587

# SMTP encryption (tls, ssl, or leave empty)
MAIL_ENCRYPTION=tls

# SMTP username
MAIL_USERNAME=noreply@example.com

# SMTP password
MAIL_PASSWORD=your_mail_password

# From address
MAIL_FROM_ADDRESS=noreply@teleroute-marketplace.com

# From name
MAIL_FROM_NAME="Teleroute Marketplace"

# Reply-to address
MAIL_REPLY_TO=support@teleroute-marketplace.com

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================

# Upload directory
UPLOAD_DIR=uploads

# Maximum upload size in MB
UPLOAD_MAX_SIZE=10

# Allowed file extensions (comma separated)
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# =====================================================
# REDIS CONFIGURATION (Optional)
# =====================================================

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Cache prefix
CACHE_PREFIX=teleroute:

# Cache default TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# =====================================================
# STRIPE PAYMENT CONFIGURATION (Optional)
# =====================================================

STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Stripe currency
STRIPE_CURRENCY=EUR

# =====================================================
# AWS S3 CONFIGURATION (Optional)
# =====================================================

S3_ENABLED=false
S3_KEY=your_aws_access_key_id
S3_SECRET=your_aws_secret_access_key
S3_REGION=eu-west-1
S3_BUCKET=teleroute-uploads
S3_URL=https://teleroute-uploads.s3.eu-west-1.amazonaws.com

# =====================================================
# GOOGLE SERVICES (Optional)
# =====================================================

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# Google Analytics Tracking ID
GOOGLE_ANALYTICS_ID=

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# =====================================================
# SOCIAL MEDIA LINKS
# =====================================================

FACEBOOK_URL=https://facebook.com/teleroute
TWITTER_URL=https://twitter.com/teleroute
LINKEDIN_URL=https://linkedin.com/company/teleroute
INSTAGRAM_URL=https://instagram.com/teleroute

# =====================================================
# NOTIFICATION SETTINGS
# =====================================================

# Enable email notifications
NOTIFICATIONS_EMAIL=true

# Enable SMS notifications
NOTIFICATIONS_SMS=false

# SMS provider (twilio, nexmo)
SMS_PROVIDER=twilio

# Twilio credentials
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# =====================================================
# LOGGING CONFIGURATION
# =====================================================

# Log level (emergency, alert, critical, error, warning, notice, info, debug)
LOG_LEVEL=error

# Log channel (single, daily, syslog, errorlog)
LOG_CHANNEL=daily

# Log directory
LOG_DIR=logs

# Maximum log files to keep
LOG_MAX_FILES=10

# Maximum log file size in MB
LOG_MAX_SIZE=10

# =====================================================
# API CONFIGURATION
# =====================================================

# API rate limit (requests per minute)
API_RATE_LIMIT=60

# API version
API_VERSION=v1

# API documentation URL
API_DOCS_URL=/api/docs

# =====================================================
# BACKUP CONFIGURATION
# =====================================================

# Backup directory
BACKUP_DIR=/var/backups/teleroute

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Enable S3 backup
BACKUP_S3_ENABLED=false

# =====================================================
# TIMEZONE & LOCALIZATION
# =====================================================

# Application timezone
TIMEZONE=Europe/Paris

# Default locale
LOCALE=fr_FR

# Date format
DATE_FORMAT=d/m/Y

# Time format
TIME_FORMAT=H:i

# DateTime format
DATETIME_FORMAT=d/m/Y H:i

# =====================================================
# PAGINATION
# =====================================================

# Items per page
ITEMS_PER_PAGE=20

# Maximum items per page
MAX_ITEMS_PER_PAGE=100

# =====================================================
# PRICING PLANS
# =====================================================

# Free plan limits
FREE_MAX_OFFERS=5
FREE_MAX_ALERTS=3

# Starter plan
STARTER_PRICE=29
STARTER_MAX_OFFERS=20
STARTER_MAX_ALERTS=10

# Professional plan
PROFESSIONAL_PRICE=79

# =====================================================
# REFERRAL PROGRAM
# =====================================================

# Referral reward in EUR
REFERRAL_REWARD=50

# Referral discount percentage
REFERRAL_DISCOUNT=20

# =====================================================
# CRON JOBS
# =====================================================

# Enable cron jobs
CRON_ENABLED=true

# Cron secret key (for securing cron endpoints)
CRON_SECRET=your_random_secret_key

# =====================================================
# MONITORING & ANALYTICS
# =====================================================

# Sentry DSN (error tracking)
SENTRY_DSN=

# New Relic License Key
NEW_RELIC_LICENSE_KEY=

# Datadog API Key
DATADOG_API_KEY=

# =====================================================
# FEATURE FLAGS
# =====================================================

# Enable 2FA
FEATURE_2FA=false

# Enable WebSockets
FEATURE_WEBSOCKETS=false

# Enable PWA
FEATURE_PWA=false

# Enable Mobile App
FEATURE_MOBILE_APP=false

# =====================================================
# MAINTENANCE MODE
# =====================================================

# Maintenance mode (true/false)
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE="Site en maintenance. Retour prévu dans quelques minutes."

# Allowed IPs during maintenance (comma separated)
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# =====================================================
# DEVELOPER OPTIONS
# =====================================================

# Show SQL queries in debug mode
SHOW_SQL_QUERIES=false

# Enable profiler
ENABLE_PROFILER=false

# Cache enabled
CACHE_ENABLED=true

# =====================================================
# NOTES
# =====================================================
#
# 1. After modifying this file, restart your web server
# 2. Never commit .env to version control
# 3. Keep .env secure (chmod 600)
# 4. Use strong passwords and random keys
# 5. Generate random keys with: openssl rand -base64 32
#
